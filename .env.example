# ── dashboard server ────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0

# 1 = built-in demo generator (no hardware). Leave empty for live data.
SIMULATE=

# Require this key on POST /api/ingest (set it on a public URL!)
INGEST_KEY=

# 0 disables the dashboard AUTO/NORMAL/SAVE buttons
ALLOW_CONTROL=true

# where samples.jsonl lives — mount a persistent volume here in production
DATA_DIR=

# ── ThingSpeak (optional) ───────────────────────────────────────────
# read readings from a channel instead of the serial bridge
THINGSPEAK_CHANNEL=
THINGSPEAK_READ_KEY=
THINGSPEAK_POLL_MS=15000
# override the field mapping only if your channel layout differs
THINGSPEAK_FIELDS=

# ── bridge (Python, reads these too) ────────────────────────────────
DASHBOARD_URL=http://localhost:3000
THINGSPEAK_WRITE_KEY=
