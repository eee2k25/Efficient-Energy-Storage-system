# Copy this file to  bridge/.env  (it is gitignored) and fill in your values.
# The bridge reads it automatically; real environment variables win over it.

# ── dashboard ───────────────────────────────────────────────────────
DASHBOARD_URL=http://localhost:3000
# must match the server's INGEST_KEY (leave empty if the server has none)
INGEST_KEY=

# ── serial ──────────────────────────────────────────────────────────
# COM3 on Windows, /dev/ttyUSB0 on Linux, /dev/cu.usbserial-* on macOS.
# Leave empty to auto-detect the ESP32.
SERIAL_PORT=COM3
SERIAL_BAUD=115200

# ── ThingSpeak (optional) ───────────────────────────────────────────
# write key lets the bridge mirror readings to your channel
THINGSPEAK_WRITE_KEY=
# read key is only needed by the server when it reads the channel instead
THINGSPEAK_READ_KEY=
THINGSPEAK_CHANNEL=
